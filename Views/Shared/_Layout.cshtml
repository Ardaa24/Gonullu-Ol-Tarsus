<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Gönüllü Ol | Tarsus — Tarsus'un gönüllü topluluğu. Etkinliklere katıl, fark yarat." />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} | Gönüllü Ol Tarsus" : "Gönüllü Ol | Tarsus")</title>

    <!-- Tailwind CSS CDN Play -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:  '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            300: '#86efac',
                            400: '#4ade80',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        },
                        slate: {
                            750: '#293548',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-gray-50 font-sans antialiased text-slate-800 min-h-screen flex flex-col">

    <!-- ── NAVBAR ── -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">

                <!-- Logo -->
                <a href="/" class="flex items-center gap-2 group">
                    <div class="w-9 h-9 bg-brand-600 rounded-xl flex items-center justify-center shadow-sm group-hover:bg-brand-700 transition-colors">
                        <span class="text-white text-lg">🌿</span>
                    </div>
                    <div class="leading-tight">
                        <div class="font-bold text-slate-800 text-sm">Gönüllü Ol</div>
                        <div class="text-brand-600 text-xs font-semibold tracking-widest uppercase">Tarsus</div>
                    </div>
                </a>

                <!-- Desktop Menü -->
                <div class="hidden md:flex items-center gap-1">
                    <a href="/" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-brand-700 hover:bg-brand-50 transition-all">
                        🏠 Ana Sayfa
                    </a>
                    <a href="/Home/NasilCalisir" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-brand-700 hover:bg-brand-50 transition-all">
                        💡 Nasıl Çalışır?
                    </a>
                    <a href="/Home/Hakkimizda" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-brand-700 hover:bg-brand-50 transition-all">
                        🌿 Hakkımızda
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Etkinlik/Olustur" class="ml-2 px-4 py-2 bg-brand-600 text-white rounded-lg text-sm font-semibold hover:bg-brand-700 transition-all shadow-sm">
                            + Etkinlik Oluştur
                        </a>
                    }
                </div>

                <!-- Sağ Alan: Auth -->
                <div class="hidden md:flex items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-sm text-slate-500">Merhaba, <strong class="text-slate-700">@User.Identity.Name?.Split('@')[0]</strong></span>
                        @if (User.IsInRole("Admin") || User.IsInRole("Super Admin"))
                        {
                            <a href="/Admin" class="px-3 py-1.5 bg-amber-100 text-amber-700 rounded-lg text-xs font-semibold hover:bg-amber-200 transition-all">
                                ⚙️ Yönetim
                            </a>
                        }
                        <form asp-controller="Account" asp-action="Cikis" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="px-3 py-1.5 text-slate-500 rounded-lg text-sm hover:text-red-600 hover:bg-red-50 transition-all">
                                Çıkış
                            </button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Giris" class="px-4 py-2 text-slate-600 rounded-lg text-sm font-medium hover:text-brand-700 hover:bg-brand-50 transition-all">
                            Giriş Yap
                        </a>
                        <a href="/Account/Kayit" class="px-4 py-2 bg-brand-600 text-white rounded-lg text-sm font-semibold hover:bg-brand-700 transition-all shadow-sm">
                            Kayıt Ol
                        </a>
                    }
                </div>

                <!-- Mobile Hamburger (basit toggle) -->
                <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-slate-500 hover:bg-gray-100 transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>

            <!-- Mobile Menü -->
            <div id="mobile-menu" class="hidden md:hidden pb-4 pt-2 border-t border-gray-100 mt-2">
                <div class="flex flex-col gap-1">
                    <a href="/" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-brand-50 hover:text-brand-700">🏠 Ana Sayfa</a>
                    <a href="/Home/NasilCalisir" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-brand-50 hover:text-brand-700">💡 Nasıl Çalışır?</a>
                    <a href="/Home/Hakkimizda" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-brand-50 hover:text-brand-700">🌿 Hakkımızda</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Etkinlik/Olustur" class="px-4 py-2 bg-brand-600 text-white rounded-lg text-sm font-semibold text-center">+ Etkinlik Oluştur</a>
                        <form asp-controller="Account" asp-action="Cikis" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-full text-left px-4 py-2 text-red-600 rounded-lg text-sm hover:bg-red-50">Çıkış Yap</button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Giris" class="px-4 py-2 text-slate-600 rounded-lg text-sm">Giriş Yap</a>
                        <a href="/Account/Kayit" class="px-4 py-2 bg-brand-600 text-white rounded-lg text-sm font-semibold text-center">Kayıt Ol</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- ── FLASH MESSAGE ── -->
    @if (TempData["Mesaj"] != null)
    {
        var tip = TempData["MesajTipi"]?.ToString() ?? "info";
        var (bg, border, text, icon) = tip switch
        {
            "success" => ("bg-green-50", "border-green-300", "text-green-800", "✅"),
            "error"   => ("bg-red-50",   "border-red-300",   "text-red-800",   "❌"),
            "info"    => ("bg-blue-50",  "border-blue-300",  "text-blue-800",  "ℹ️"),
            _         => ("bg-gray-50",  "border-gray-300",  "text-gray-800",  "📌")
        };
        <div class="@bg border-l-4 @border @text px-6 py-3 flex items-center gap-3 animate-fade-in" role="alert">
            <span class="text-lg">@icon</span>
            <p class="text-sm font-medium">@TempData["Mesaj"]</p>
        </div>
    }

    <!-- ── ANA İÇERİK ── -->
    <main class="flex-1">
        @RenderBody()
    </main>

    <!-- ── FOOTER ── -->
    <footer class="bg-slate-800 text-slate-300 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

                <!-- Hakkında -->
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-2xl">🌿</span>
                        <div>
                            <p class="font-bold text-white text-sm">Gönüllü Ol | Tarsus</p>
                            <p class="text-xs text-brand-400">Birlikte daha güçlüyüz</p>
                        </div>
                    </div>
                    <p class="text-sm leading-relaxed text-slate-400">
                        Tarsus'ta gönüllülüğü yaygınlaştırmak ve topluluk bağını güçlendirmek için kurulmuş yerel bir platformuz.
                    </p>
                </div>

                <!-- Hızlı Erişim -->
                <div>
                    <h3 class="font-semibold text-white mb-3 text-sm uppercase tracking-wide">Hızlı Erişim</h3>
                    <ul class="space-y-2 text-sm">
                        <li><a href="/" class="hover:text-brand-400 transition-colors">🏠 Ana Sayfa</a></li>
                        <li><a href="/?kategori=1" class="hover:text-brand-400 transition-colors">🌿 Çevre Etkinlikleri</a></li>
                        <li><a href="/?kategori=2" class="hover:text-brand-400 transition-colors">🐾 Barınak Ziyaretleri</a></li>
                        <li><a href="/?kategori=3" class="hover:text-brand-400 transition-colors">📚 Eğitim Desteği</a></li>
                        <li><a href="/?kategori=4" class="hover:text-brand-400 transition-colors">💛 Yaşlı Bakımı</a></li>
                    </ul>
                </div>

                <!-- İletişim & Kurumsal -->
                <div>
                    <h3 class="font-semibold text-white mb-3 text-sm uppercase tracking-wide">Kurumsal & İletişim</h3>
                    <ul class="space-y-2 text-sm text-slate-400">
                        <li><a href="/Home/GizlilikPolitikasi" class="hover:text-brand-400 transition-colors">Gizlilik Politikası</a></li>
                        <li><a href="/Home/CerezPolitikasi" class="hover:text-brand-400 transition-colors">Çerez Politikası</a></li>
                        <li class="flex items-center gap-2 mt-4">
                            <span>📍</span> Tarsus, Mersin, Türkiye
                        </li>
                        <li class="flex items-center gap-2">
                            <span>✉️</span>
                            <a href="mailto:iletisim@gonulluoltarsus.com" class="hover:text-brand-400 transition-colors">
                                iletisim&#64;gonulluoltarsus.com
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="border-t border-slate-700 mt-8 pt-6 text-center text-xs text-slate-500">
                <p>© @DateTime.Now.Year Gönüllü Ol | Tarsus. Tüm hakları saklıdır.</p>
                <p class="mt-1">Tarsus'un gönüllü ruhuyla ❤️ ile yapılmıştır.</p>
                <p class="mt-0"><a href="https://www.linkedin.com/in/arda-can-süren-52605a314/" class="hover:text-brand-400 transition-colors" target="_blank"> Geliştirici: Arda24</a></p>
            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script>
        // Mobile menü toggle
        document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
            const menu = document.getElementById('mobile-menu');
            menu?.classList.toggle('hidden');
        });

        // Flash mesajını 5 saniye sonra kaldır
        setTimeout(() => {
            const alert = document.querySelector('[role="alert"]');
            if (alert) {
                alert.style.transition = 'opacity 0.5s';
                alert.style.opacity = '0';
                setTimeout(() => alert.remove(), 500);
            }
        }, 5000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
