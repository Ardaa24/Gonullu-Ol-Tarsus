@model EtkinlikOzetViewModel
@* Partial View — DRY için tek kart bileşeni. _EtkinlikKarti.cshtml *@

<article class="etkinlik-karti bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden flex flex-col hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group @(Model.IptalEdildi ? "opacity-60 grayscale-[50%]" : "")">

    <!-- Kategori Renk Şeridi -->
    <div class="h-1.5 @GetKategoriBandRengi(Model.Kategori)"></div>

    <!-- Kart İçerik -->
    <div class="p-5 flex flex-col flex-1">

        <!-- Üst Bilgi: Kategori Rozeti + Tarih -->
        <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold @GetKategoriRenk(Model.Kategori)">
                @Model.KategoriEmoji @Model.KategoriAdi
            </span>
            <span class="text-xs text-slate-400 font-medium">
                📅 @Model.Tarih.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
            </span>
        </div>

        <!-- Başlık -->
        <h3 class="font-bold text-slate-800 text-base leading-snug mb-2 group-hover:text-brand-700 transition-colors line-clamp-2">
            @Model.Baslik
            @if (Model.IptalEdildi)
            {
                <span class="inline-block ml-1 px-2 py-0.5 bg-red-100 text-red-700 text-[10px] font-bold rounded uppercase tracking-wider align-middle">İptal Edildi</span>
            }
        </h3>

        <!-- Açıklama -->
        <p class="text-slate-500 text-sm leading-relaxed flex-1 line-clamp-3 mb-4">
            @Model.Aciklama
        </p>

        <!-- Konum -->
        <div class="flex items-center gap-1.5 text-slate-400 text-xs mb-4">
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="truncate">@Model.Konum</span>
        </div>

        <!-- Alt Bilgi: Kontenjan + Buton -->
        <div class="flex items-center justify-between pt-3 border-t border-gray-100">
            <!-- Kontenjan Göstergesi -->
            <div class="flex items-center gap-2">
                @if (Model.DoluMu)
                {
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-red-100 text-red-700 rounded-full text-xs font-semibold">
                        🔴 Dolu
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1 text-slate-500 text-xs">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span class="font-medium text-brand-600">@Model.KalanKontenjan</span> kişilik yer
                    </span>
                }
            </div>

            <!-- Detay Butonu -->
            <a href="/Etkinlik/Detay/@Model.Id"
               class="inline-flex items-center gap-1 px-3 py-1.5 bg-brand-600 text-white text-xs font-semibold rounded-lg hover:bg-brand-700 transition-colors">
                İncele
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </a>
        </div>
    </div>
</article>

@functions {
    private static string GetKategoriBandRengi(GonulluOlTarsus.Domain.Enums.KategoriTip kategori) => kategori switch
    {
        GonulluOlTarsus.Domain.Enums.KategoriTip.Cevre      => "bg-emerald-500",
        GonulluOlTarsus.Domain.Enums.KategoriTip.Barinak    => "bg-amber-500",
        GonulluOlTarsus.Domain.Enums.KategoriTip.Egitim     => "bg-blue-500",
        GonulluOlTarsus.Domain.Enums.KategoriTip.YasliBakimi => "bg-yellow-400",
        GonulluOlTarsus.Domain.Enums.KategoriTip.Diger      => "bg-purple-500",
        _ => "bg-gray-400"
    };

    private static string GetKategoriRenk(GonulluOlTarsus.Domain.Enums.KategoriTip kategori) => kategori switch
    {
        GonulluOlTarsus.Domain.Enums.KategoriTip.Cevre      => "bg-emerald-100 text-emerald-700",
        GonulluOlTarsus.Domain.Enums.KategoriTip.Barinak    => "bg-amber-100 text-amber-700",
        GonulluOlTarsus.Domain.Enums.KategoriTip.Egitim     => "bg-blue-100 text-blue-700",
        GonulluOlTarsus.Domain.Enums.KategoriTip.YasliBakimi => "bg-yellow-100 text-yellow-700",
        GonulluOlTarsus.Domain.Enums.KategoriTip.Diger      => "bg-purple-100 text-purple-700",
        _ => "bg-gray-100 text-gray-700"
    };
}
