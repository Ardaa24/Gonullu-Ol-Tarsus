@model EtkinlikDetayViewModel
@{
    ViewData["Title"] = Model.Baslik;
}

<!-- Breadcrumb -->
<div class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex items-center gap-2 text-sm text-slate-400">
            <a href="/" class="hover:text-brand-600 transition-colors">Ana Sayfa</a>
            <span>›</span>
            <a href="/?kategori=@((int)Model.Kategori)" class="hover:text-brand-600 transition-colors">@Model.KategoriAdi</a>
            <span>›</span>
            <span class="text-slate-600 font-medium truncate max-w-xs">@Model.Baslik</span>
        </nav>
    </div>
</div>

<!-- Ana İçerik -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- ── SOL SÜTUN: Etkinlik Detayları (2/3) ── -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Başlık Kartı -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
                <!-- Kategori + Onay Durumu -->
                <div class="flex items-center justify-between flex-wrap gap-2 mb-4">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-semibold
                        @(Model.Kategori switch {
                            GonulluOlTarsus.Domain.Enums.KategoriTip.Cevre => "bg-emerald-100 text-emerald-700",
                            GonulluOlTarsus.Domain.Enums.KategoriTip.Barinak => "bg-amber-100 text-amber-700",
                            GonulluOlTarsus.Domain.Enums.KategoriTip.Egitim => "bg-blue-100 text-blue-700",
                            GonulluOlTarsus.Domain.Enums.KategoriTip.YasliBakimi => "bg-yellow-100 text-yellow-700",
                            _ => "bg-purple-100 text-purple-700"
                        })">
                        @Model.KategoriEmoji @Model.KategoriAdi
                    </span>
                    @if (Model.IptalEdildi)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-red-100 text-red-700 rounded-full text-sm font-semibold border border-red-200">
                            🚫 İptal Edildi
                        </span>
                    }
                    else if (!Model.AdminOnaylandi)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-amber-50 text-amber-700 rounded-full text-sm font-semibold border border-amber-200">
                            ⏳ Admin Onayı Bekleniyor
                        </span>
                    }
                </div>

                <!-- Başlık -->
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-800 leading-tight mb-6">
                    @Model.Baslik
                </h1>

                <!-- Meta Bilgiler Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <!-- Tarih -->
                    <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-xl">
                        <div class="w-9 h-9 bg-brand-100 rounded-lg flex items-center justify-center flex-shrink-0">
                            <span class="text-lg">📅</span>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Tarih</p>
                            <p class="text-sm font-semibold text-slate-700 mt-0.5">
                                @Model.Tarih.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                            </p>
                            <p class="text-xs text-slate-400">Saat @Model.Tarih.ToString("HH:mm")</p>
                        </div>
                    </div>

                    <!-- Konum -->
                    <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-xl">
                        <div class="w-9 h-9 bg-brand-100 rounded-lg flex items-center justify-center flex-shrink-0">
                            <span class="text-lg">📍</span>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Konum</p>
                            <p class="text-sm font-semibold text-slate-700 mt-0.5">@Model.Konum</p>
                        </div>
                    </div>

                    <!-- Kontenjan -->
                    <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-xl">
                        <div class="w-9 h-9 bg-brand-100 rounded-lg flex items-center justify-center flex-shrink-0">
                            <span class="text-lg">👥</span>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Kontenjan</p>
                            <p class="text-sm font-semibold text-slate-700 mt-0.5">
                                @Model.KatilimciSayisi / @Model.Kontenjan kişi
                            </p>
                            <p class="text-xs @(Model.EtkinlikDolu ? "text-red-500" : "text-brand-600") font-medium">
                                @(Model.EtkinlikDolu ? "Kontenjan doldu" : $"{Model.KalanKontenjan} kişilik yer kaldı")
                            </p>
                        </div>
                    </div>

                    <!-- Oluşturan -->
                    <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-xl">
                        <div class="w-9 h-9 bg-brand-100 rounded-lg flex items-center justify-center flex-shrink-0">
                            <span class="text-lg">🙋</span>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Düzenleyen</p>
                            <p class="text-sm font-semibold text-slate-700 mt-0.5">@Model.OlusturanAdSoyad</p>
                            <p class="text-xs text-slate-400">
                                @Model.OlusturulmaTarihi.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Kontenjan İlerleme Çubuğu -->
                @{
                    var dolulukYuzdesi = Model.Kontenjan > 0
                        ? (int)((double)Model.KatilimciSayisi / Model.Kontenjan * 100)
                        : 0;
                    var progresRenk = dolulukYuzdesi >= 90 ? "bg-red-500" : dolulukYuzdesi >= 60 ? "bg-amber-500" : "bg-brand-500";
                }
                <div class="mb-2">
                    <div class="flex justify-between text-xs text-slate-400 mb-1">
                        <span>Doluluk Oranı</span>
                        <span>%@dolulukYuzdesi</span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-2">
                        <div class="@progresRenk h-2 rounded-full transition-all duration-500" style="width: @dolulukYuzdesi%"></div>
                    </div>
                </div>
            </div>

            <!-- Açıklama Kartı -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
                <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                    <span class="w-1 h-5 bg-brand-500 rounded-full"></span>
                    Etkinlik Hakkında
                </h2>
                <div class="prose prose-slate max-w-none text-slate-600 leading-relaxed">
                    @foreach (var paragraf in Model.Aciklama.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <p class="mb-3 text-sm">@paragraf</p>
                    }
                </div>
        </div>

        <!-- Yorumlar / Soru-Cevap Kartı -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
            <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span class="w-1 h-5 bg-brand-500 rounded-full"></span>
                Yorumlar & Sorular
                <span class="text-xs bg-gray-100 text-slate-500 px-2 py-0.5 rounded-full font-semibold ml-auto">
                    @Model.YorumSayisi yorum
                </span>
            </h2>

            <!-- Yorum Formu -->
            @if (Model.KullaniciGirisYapti && Model.AdminOnaylandi && !Model.IptalEdildi)
            {
                <form asp-controller="Etkinlik" asp-action="YorumEkle" method="post" class="mb-6">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="etkinlikId" value="@Model.Id" />
                    <div class="flex gap-3">
                        <div class="w-8 h-8 bg-brand-100 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                            <span class="text-xs font-bold text-brand-600">✍</span>
                        </div>
                        <div class="flex-1">
                            <textarea name="icerik" rows="3" maxlength="1000"
                                      placeholder="Bir soru sorun veya yorum bırakın..."
                                      class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition-all text-sm resize-none"></textarea>
                            <div class="flex justify-end mt-2">
                                <button type="submit"
                                        class="px-5 py-2 bg-brand-600 text-white font-semibold rounded-lg hover:bg-brand-700 transition-all text-sm">
                                    💬 Yorum Yap
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            }
            else if (!Model.KullaniciGirisYapti)
            {
                <div class="mb-6 p-3 bg-gray-50 rounded-xl text-center">
                    <p class="text-sm text-slate-400">
                        Yorum yapmak için <a href="/Account/Giris?geriDonusUrl=/Etkinlik/Detay/@Model.Id" class="text-brand-600 font-semibold hover:underline">giriş yapın</a>.
                    </p>
                </div>
            }

            <!-- Yorum Listesi -->
            @if (!Model.Yorumlar.Any())
            {
                <div class="text-center py-6">
                    <p class="text-slate-400 text-sm">Henüz yorum yok.</p>
                    <p class="text-slate-300 text-xs mt-1">İlk yorumu sen yaz! 💬</p>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var yorum in Model.Yorumlar)
                    {
                        <div class="flex gap-3 p-3 rounded-xl hover:bg-gray-50 transition-colors @(yorum.KendiYorumu ? "bg-brand-50/50 border border-brand-100" : "")">
                            <div class="w-8 h-8 bg-brand-100 rounded-full flex items-center justify-center flex-shrink-0">
                                <span class="text-xs font-bold text-brand-600">
                                    @(yorum.YazarAd.Length > 0 ? yorum.YazarAd[0].ToString().ToUpper() : "?")
                                </span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-sm font-semibold text-slate-700">@yorum.YazarAd</span>
                                    @if (yorum.KendiYorumu)
                                    {
                                        <span class="text-xs bg-brand-100 text-brand-600 px-1.5 py-0.5 rounded font-medium">Siz</span>
                                    }
                                    <span class="text-xs text-slate-400">
                                        @yorum.YazilmaTarihi.ToString("dd MMM yyyy HH:mm", new System.Globalization.CultureInfo("tr-TR"))
                                    </span>
                                </div>
                                <p class="text-sm text-slate-600 leading-relaxed">@yorum.Icerik</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

        <!-- ── SAĞ SÜTUN: Katılım + Katılımcı Listesi (1/3) ── -->
        <div class="space-y-5">

            <!-- Katılım Kartı -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 sticky top-20">
                <h2 class="text-base font-bold text-slate-800 mb-4">Gönüllü Ol</h2>

                @if (Model.IptalEdildi)
                {
                    <div class="p-3 bg-red-50 rounded-xl text-center">
                        <p class="text-sm text-red-600 font-bold">🚫 Bu etkinlik iptal edilmiştir.</p>
                        <p class="text-xs text-red-500 mt-1">Katılım sağlanamaz.</p>
                    </div>
                }
                else if (Model.EtkinlikGecmis)
                {
                    <div class="p-3 bg-gray-50 rounded-xl text-center">
                        <p class="text-sm text-slate-400">⏰ Bu etkinlik sona erdi.</p>
                    </div>
                }
                else if (!Model.AdminOnaylandi)
                {
                    <div class="p-3 bg-amber-50 rounded-xl text-center">
                        <p class="text-sm text-amber-600">⏳ Etkinlik henüz onaylanmadı.</p>
                    </div>
                }
                else if (Model.EtkinlikDolu)
                {
                    <div class="p-3 bg-red-50 rounded-xl text-center">
                        <p class="text-sm text-red-500 font-semibold">🔴 Kontenjan doldu</p>
                        <p class="text-xs text-red-400 mt-1">Maalesef yer kalmadı.</p>
                    </div>
                }
                else if (!Model.KullaniciGirisYapti)
                {
                    <div class="text-center space-y-3">
                        <p class="text-sm text-slate-400">Katılmak için giriş yapmanız gerekiyor.</p>
                        <a href="/Account/Giris?geriDonusUrl=/Etkinlik/Detay/@Model.Id"
                           class="block w-full py-3 bg-brand-600 text-white font-bold rounded-xl hover:bg-brand-700 transition-all text-sm text-center">
                            🔑 Giriş Yap
                        </a>
                        <a href="/Account/Kayit"
                           class="block w-full py-2.5 border border-brand-200 text-brand-700 font-semibold rounded-xl hover:bg-brand-50 transition-all text-sm text-center">
                            Üye Ol
                        </a>
                    </div>
                }
                else if (Model.KullaniciZatenKatildi)
                {
                    <div class="space-y-3">
                        <div class="p-3 bg-green-50 rounded-xl text-center">
                            <p class="text-sm text-green-700 font-semibold">✅ Bu etkinliğe kayıtlısınız!</p>
                            <p class="text-xs text-green-500 mt-1">Etkinliği bekliyoruz 🎉</p>
                        </div>
                        <form asp-controller="Etkinlik" asp-action="KatilimIptal" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    onclick="return confirm('Katılımınızı iptal etmek istediğinizden emin misiniz?')"
                                    class="w-full py-2.5 border border-red-200 text-red-600 font-semibold rounded-xl hover:bg-red-50 transition-all text-sm">
                                Katılımı İptal Et
                            </button>
                        </form>
                    </div>
                }
                else if (Model.KullaniciKendiEtkinligi)
                {
                    <div class="space-y-3">
                        <div class="p-3 bg-blue-50 rounded-xl text-center">
                            <p class="text-sm text-blue-700 font-semibold">Bu etkinliği siz oluşturdunuz.</p>
                            <p class="text-xs text-blue-500 mt-1">Kendi etkinliğinize katılamazsınız.</p>
                        </div>
                        <form asp-controller="Etkinlik" asp-action="IptalEt" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    onclick="return confirm('Etkinliği iptal etmek istediğinize emin misiniz? Bu işlem geri alınamaz.')"
                                    class="w-full py-2.5 border border-red-200 text-red-600 font-semibold rounded-xl hover:bg-red-50 transition-all text-sm mt-2">
                                Etkinliği İptal Et
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="space-y-3">
                        <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
                            <span>@Model.KalanKontenjan kişilik yer kaldı</span>
                            <span>@Model.KatilimciSayisi/@Model.Kontenjan</span>
                        </div>
                        <form asp-controller="Etkinlik" asp-action="Katil" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="w-full py-3.5 bg-brand-600 text-white font-bold rounded-xl hover:bg-brand-700 transition-all text-sm shadow-md hover:shadow-lg">
                                ✋ Gönüllü Ol
                            </button>
                        </form>
                        <p class="text-xs text-center text-slate-400">Katılım ücretsizdir. İstediğiniz zaman iptal edebilirsiniz.</p>
                    </div>
                }
            </div>

            <!-- Katılımcı Listesi -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                <h2 class="text-base font-bold text-slate-800 mb-4 flex items-center justify-between">
                    <span>👥 Katılımcılar</span>
                    <span class="text-xs bg-brand-100 text-brand-700 px-2 py-0.5 rounded-full font-semibold">
                        @Model.KatilimciSayisi kişi
                    </span>
                </h2>

                @if (!Model.Katilimcilar.Any())
                {
                    <div class="text-center py-6">
                        <p class="text-slate-400 text-sm">Henüz katılımcı yok.</p>
                        <p class="text-slate-300 text-xs mt-1">İlk gönüllü sen ol! 🌟</p>
                    </div>
                }
                else
                {
                    <ul class="space-y-2">
                        @foreach (var katilimci in Model.Katilimcilar)
                        {
                            <li class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 transition-colors">
                                <!-- Avatar -->
                                <div class="w-8 h-8 bg-brand-100 rounded-full flex items-center justify-center flex-shrink-0">
                                    <span class="text-xs font-bold text-brand-600">
                                        @(katilimci.AdSoyad.Length > 0 ? katilimci.AdSoyad[0].ToString().ToUpper() : "?")
                                    </span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-slate-700 truncate">@katilimci.AdSoyad</p>
                                    <p class="text-xs text-slate-400">
                                        @katilimci.KatilimTarihi.ToString("dd MMM", new System.Globalization.CultureInfo("tr-TR")) tarihinde katıldı
                                    </p>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>

            <!-- Geri Dön -->
            <a href="/"
               class="flex items-center justify-center gap-2 px-5 py-3 bg-gray-100 text-slate-600 rounded-xl hover:bg-gray-200 transition-all text-sm font-medium w-full">
                ← Tüm Etkinliklere Dön
            </a>
        </div>
    </div>
</div>
