@model EtkinlikOlusturViewModel
@{
    ViewData["Title"] = "Etkinlik Oluştur";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Başlık -->
    <div class="mb-8">
        <h1 class="text-2xl font-extrabold text-slate-800 mb-2">Yeni Etkinlik Oluştur</h1>
        <p class="text-slate-400 text-sm">
            Etkinliğiniz, admin onayından sonra <strong class="text-brand-600">yayınlanacaktır</strong>.
            Tüm alanları eksiksiz doldurun.
        </p>
    </div>

    <!-- Form Kartı -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
        <form asp-action="Olustur" method="post" novalidate class="space-y-5">
            @Html.AntiForgeryToken()

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="p-3 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm hidden [&:not(:empty)]:block"></div>

            <!-- Başlık -->
            <div>
                <label asp-for="Baslik" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                <input asp-for="Baslik"
                       class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent placeholder-slate-400 transition-all"
                       placeholder="Örn: Berdan Nehri Temizlik Kampanyası" />
                <span asp-validation-for="Baslik" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Açıklama -->
            <div>
                <label asp-for="Aciklama" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                <textarea asp-for="Aciklama"
                          rows="5"
                          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent placeholder-slate-400 transition-all resize-none"
                          placeholder="Etkinlik hakkında ayrıntılı bilgi verin. Katılımcıların ne gerekireceğini belirtin."></textarea>
                <span asp-validation-for="Aciklama" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Tarih + Kontenjan (yan yana) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Tarih" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                    <input asp-for="Tarih"
                           type="datetime-local"
                           class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition-all" />
                    <span asp-validation-for="Tarih" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Kontenjan" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                    <input asp-for="Kontenjan"
                           type="number"
                           min="1"
                           max="1000"
                           class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition-all" />
                    <span asp-validation-for="Kontenjan" class="text-red-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <!-- Konum -->
            <div>
                <label asp-for="Konum" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                <input asp-for="Konum"
                       class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent placeholder-slate-400 transition-all"
                       placeholder="Örn: Berdan Nehri Piknik Alanı, Tarsus" />
                <span asp-validation-for="Konum" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Kategori -->
            <div>
                <label asp-for="Kategori" class="block text-sm font-semibold text-slate-700 mb-2"></label>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                    @foreach (var (deger, emoji, ad, renk) in new[]
                    {
                        (GonulluOlTarsus.Domain.Enums.KategoriTip.Cevre,       "🌿", "Çevre",        "border-emerald-300 text-emerald-700 bg-emerald-50"),
                        (GonulluOlTarsus.Domain.Enums.KategoriTip.Barinak,     "🐾", "Barınak",      "border-amber-300 text-amber-700 bg-amber-50"),
                        (GonulluOlTarsus.Domain.Enums.KategoriTip.Egitim,      "📚", "Eğitim",       "border-blue-300 text-blue-700 bg-blue-50"),
                        (GonulluOlTarsus.Domain.Enums.KategoriTip.YasliBakimi, "💛", "Yaşlı Bakımı", "border-yellow-300 text-yellow-700 bg-yellow-50"),
                        (GonulluOlTarsus.Domain.Enums.KategoriTip.Diger,       "🤝", "Diğer",        "border-purple-300 text-purple-700 bg-purple-50"),
                    })
                    {
                        <label class="cursor-pointer">
                            <input type="radio"
                                   name="Kategori"
                                   value="@((int)deger)"
                                   class="sr-only peer"
                                   @(Model.Kategori == deger ? "checked" : "") />
                            <div class="flex items-center gap-2 px-3 py-2.5 border-2 border-gray-200 rounded-xl text-sm font-semibold text-slate-500 bg-white hover:@renk peer-checked:@renk transition-all cursor-pointer">
                                <span>@emoji</span> @ad
                            </div>
                        </label>
                    }
                </div>
                <span asp-validation-for="Kategori" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Bilgi Notu -->
            <div class="flex items-start gap-2 p-3 bg-amber-50 border border-amber-200 rounded-xl">
                <span class="text-amber-500 mt-0.5">⚠️</span>
                <p class="text-xs text-amber-700 leading-relaxed">
                    Oluşturduğunuz etkinlik, <strong>platform yöneticisi tarafından incelenip onaylandıktan</strong> sonra diğer kullanıcılara görünür hale gelir.
                    Onay süreci genellikle 24 saat içinde tamamlanır.
                </p>
            </div>

            <!-- Butonlar -->
            <div class="flex justify-end gap-3 pt-2">
                <a href="/"
                   class="px-5 py-2.5 text-slate-500 rounded-xl hover:bg-gray-100 transition-all text-sm font-medium">
                    İptal
                </a>
                <button type="submit"
                        class="px-7 py-2.5 bg-brand-600 text-white font-bold rounded-xl hover:bg-brand-700 transition-all text-sm shadow-md hover:shadow-lg">
                    📤 Etkinliği Gönder
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Kategori radio'larını seçildiğinde güncelle
        document.querySelectorAll('input[name="Kategori"]').forEach(radio => {
            radio.addEventListener('change', function() {
                // Görsel güncelleme CSS peer selector ile yapılıyor
            });
        });
    </script>
}
