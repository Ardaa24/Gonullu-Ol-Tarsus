@model EtkinlikListeViewModel
@{
    ViewData["Title"] = "Etkinlikler";
}

<!-- ── HERO SECTION ── -->
<section class="relative bg-gradient-to-br from-brand-800 via-brand-700 to-slate-800 text-white overflow-hidden">
    <!-- Dekoratif arka plan deseni -->
    <div class="absolute inset-0 opacity-10">
        <div class="absolute top-10 left-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
        <div class="absolute bottom-10 right-10 w-96 h-96 bg-brand-300 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
        <div class="max-w-3xl">
            <!-- Rozet -->
            <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-1.5 text-sm font-medium mb-6">
                <span>📍</span>
                <span>Tarsus, Mersin — Yerel Gönüllülük Platformu</span>
            </div>

            <!-- Ana Başlık -->
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-6 tracking-tight">
                Tarsus'ta<br />
                <span class="text-brand-300">Fark Yaratmak</span><br />
                Senin Elinde!
            </h1>

            <p class="text-lg sm:text-xl text-brand-100 leading-relaxed mb-10 max-w-2xl">
                Çevre temizliğinden barınak ziyaretlerine, eğitim desteğinden yaşlı bakımına kadar
                yüzlerce gönüllü etkinliğe katıl. Tarsus topluluğunu birlikte güçlendirelim.
            </p>

            <!-- CTA Butonlar -->
            <div class="flex flex-col sm:flex-row gap-3">
                <a href="#etkinlikler"
                   class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white text-brand-700 font-bold rounded-xl hover:bg-brand-50 transition-all shadow-lg text-sm">
                    🔍 Etkinlikleri Keşfet
                </a>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a href="/Account/Kayit"
                       class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-brand-500/20 backdrop-blur-sm border border-white/30 text-white font-semibold rounded-xl hover:bg-brand-500/30 transition-all text-sm">
                        ✋ Gönüllü Ol
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- İstatistikler Bandı -->
    <div class="relative bg-white/10 backdrop-blur-sm border-t border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
            <div class="grid grid-cols-3 gap-4 text-center">
                <div>
                    <p class="text-2xl font-extrabold">@Model.ToplamEtkinlik</p>
                    <p class="text-xs text-brand-200 font-medium mt-0.5">Aktif Etkinlik</p>
                </div>
                <div>
                    <p class="text-2xl font-extrabold">5</p>
                    <p class="text-xs text-brand-200 font-medium mt-0.5">Kategori</p>
                </div>
                <div>
                    <p class="text-2xl font-extrabold">Tarsus</p>
                    <p class="text-xs text-brand-200 font-medium mt-0.5">Şehrimiz</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── KATEGORİ FİLTRE ── -->
<section id="etkinlikler" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-4">
    <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm font-semibold text-slate-500 mr-2">Filtrele:</span>

        @{
            var tumSecili = Model.SecilenKategori == null;
        }

        <a href="/"
           class="px-4 py-2 rounded-full text-sm font-semibold transition-all @(tumSecili ? "bg-brand-600 text-white shadow-sm" : "bg-white text-slate-600 border border-gray-200 hover:border-brand-300 hover:text-brand-700")">
            🌟 Tümü
        </a>

        @foreach (var (emoji, ad, deger, aktifRenk) in new[]
        {
            ("🌿", "Çevre",       GonulluOlTarsus.Domain.Enums.KategoriTip.Cevre,       "bg-emerald-600 text-white"),
            ("🐾", "Barınak",     GonulluOlTarsus.Domain.Enums.KategoriTip.Barinak,     "bg-amber-500 text-white"),
            ("📚", "Eğitim",      GonulluOlTarsus.Domain.Enums.KategoriTip.Egitim,      "bg-blue-600 text-white"),
            ("💛", "Yaşlı Bakımı",GonulluOlTarsus.Domain.Enums.KategoriTip.YasliBakimi,"bg-yellow-500 text-white"),
            ("🤝", "Diğer",       GonulluOlTarsus.Domain.Enums.KategoriTip.Diger,       "bg-purple-600 text-white"),
        })
        {
            var secili = Model.SecilenKategori == deger;
            <a href="/?kategori=@((int)deger)"
               class="px-4 py-2 rounded-full text-sm font-semibold transition-all @(secili ? aktifRenk + " shadow-sm" : "bg-white text-slate-600 border border-gray-200 hover:border-brand-300 hover:text-brand-700")">
                @emoji @ad
            </a>
        }
    </div>
</section>

<!-- ── ETKİNLİK LİSTESİ ── -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 pt-6">

    @if (!Model.Etkinlikler.Any())
    {
        <!-- Boş Durum -->
        <div class="text-center py-20">
            <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-4xl">🔍</span>
            </div>
            <h3 class="text-lg font-semibold text-slate-600 mb-2">Bu kategoride etkinlik bulunamadı</h3>
            <p class="text-slate-400 text-sm mb-6">Farklı bir kategori seçin veya tüm etkinlikleri görüntüleyin.</p>
            <a href="/" class="px-5 py-2.5 bg-brand-600 text-white rounded-lg text-sm font-semibold hover:bg-brand-700 transition-all">
                Tüm Etkinlikleri Gör
            </a>
        </div>
    }
    else
    {
        <!-- Sonuç Sayısı -->
        <div class="flex items-center justify-between mb-6">
            <p class="text-slate-500 text-sm">
                <strong class="text-slate-700">@Model.ToplamEtkinlik</strong> etkinlik listeleniyor
                @if (Model.SecilenKategori.HasValue)
                {
                    <span> — @Model.SecilenKategori kategorisinde</span>
                }
            </p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/Etkinlik/Olustur"
                   class="inline-flex items-center gap-1.5 px-4 py-2 bg-brand-600 text-white text-sm font-semibold rounded-lg hover:bg-brand-700 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Etkinlik Oluştur
                </a>
            }
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var etkinlik in Model.Etkinlikler)
            {
                @await Html.PartialAsync("_EtkinlikKarti", etkinlik)
            }
        </div>
    }
</section>

<!-- ── KATILIM ÇAĞRISI (Giriş yapmamış kullanıcılar için) ── -->
@if (User.Identity?.IsAuthenticated != true)
{
    <section class="bg-brand-50 border-y border-brand-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 text-center">
            <h2 class="text-2xl font-bold text-slate-800 mb-3">Tarsus Gönüllü Topluluğuna Katıl</h2>
            <p class="text-slate-500 mb-7 max-w-xl mx-auto">Ücretsiz hesap oluştur, etkinliklere kaydol ve Tarsus'ta gerçek bir fark yarat.</p>
            <div class="flex justify-center gap-3 flex-wrap">
                <a href="/Account/Kayit"
                   class="px-6 py-3 bg-brand-600 text-white font-bold rounded-xl hover:bg-brand-700 transition-all shadow-md">
                    ✋ Hemen Üye Ol
                </a>
                <a href="/Account/Giris"
                   class="px-6 py-3 border border-brand-300 text-brand-700 font-semibold rounded-xl hover:bg-brand-100 transition-all">
                    Giriş Yap
                </a>
            </div>
        </div>
    </section>
}
