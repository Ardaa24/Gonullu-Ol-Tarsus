@model GirisViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="min-h-[calc(100vh-200px)] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

        <!-- Logo / Başlık -->
        <div class="text-center mb-8">
            <div class="w-14 h-14 bg-brand-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
                <span class="text-2xl">🌿</span>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-800">Tekrar Hoş Geldiniz</h1>
            <p class="text-slate-400 text-sm mt-1">Hesabınıza giriş yapın</p>
        </div>

        <!-- Form Kartı -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-7">
            <form asp-action="Giris" method="post" novalidate class="space-y-4">
                @Html.AntiForgeryToken()
                <input asp-for="GeriDonusUrl" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="p-3 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm [&:empty]:hidden"></div>

                <!-- E-posta -->
                <div>
                    <label asp-for="Email" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                    <input asp-for="Email"
                           type="email"
                           autocomplete="email"
                           class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition-all"
                           placeholder="ornek@email.com" />
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Şifre -->
                <div>
                    <label asp-for="Sifre" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                    <input asp-for="Sifre"
                           type="password"
                           autocomplete="current-password"
                           class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition-all"
                           placeholder="••••••••" />
                    <span asp-validation-for="Sifre" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Beni Hatırla -->
                <div class="flex items-center">
                    <input asp-for="BeniHatirla"
                           type="checkbox"
                           class="w-4 h-4 accent-brand-600 rounded" />
                    <label asp-for="BeniHatirla" class="ml-2 text-sm text-slate-600"></label>
                </div>

                <!-- Giriş Butonu -->
                <button type="submit"
                        class="w-full py-3 bg-brand-600 text-white font-bold rounded-xl hover:bg-brand-700 transition-all shadow-md hover:shadow-lg text-sm">
                    Giriş Yap
                </button>
            </form>
        </div>

        <!-- Kayıt Linki -->
        <p class="text-center text-sm text-slate-400 mt-5">
            Hesabınız yok mu?
            <a href="/Account/Kayit" class="text-brand-600 font-semibold hover:text-brand-700 transition-colors">
                Ücretsiz Kayıt Ol →
            </a>
        </p>
    </div>
</div>
