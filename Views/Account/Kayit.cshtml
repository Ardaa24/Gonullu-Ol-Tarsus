@model KayitViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="min-h-[calc(100vh-200px)] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

        <!-- Logo / Başlık -->
        <div class="text-center mb-8">
            <div class="w-14 h-14 bg-brand-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
                <span class="text-2xl">✋</span>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-800">Gönüllü Topluluğumuza Katıl</h1>
            <p class="text-slate-400 text-sm mt-1">Ücretsiz hesap oluştur, Tarsus'ta fark yarat</p>
        </div>

        <!-- Form Kartı -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-7">
            <form asp-action="Kayit" method="post" novalidate class="space-y-4">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="p-3 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm [&:empty]:hidden"></div>

                <!-- Ad + Soyad -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label asp-for="Ad" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                        <input asp-for="Ad"
                               autocomplete="given-name"
                               class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition-all"
                               placeholder="Arda" />
                        <span asp-validation-for="Ad" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Soyad" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                        <input asp-for="Soyad"
                               autocomplete="family-name"
                               class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition-all"
                               placeholder="Can" />
                        <span asp-validation-for="Soyad" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                </div>

                <!-- E-posta -->
                <div>
                    <label asp-for="Email" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                    <input asp-for="Email"
                           type="email"
                           autocomplete="email"
                           class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition-all"
                           placeholder="ornek@email.com" />
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Şifre -->
                <div>
                    <label asp-for="Sifre" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                    <input asp-for="Sifre"
                           type="password"
                           autocomplete="new-password"
                           class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition-all"
                           placeholder="En az 8 karakter" />
                    <span asp-validation-for="Sifre" class="text-red-500 text-xs mt-1 block"></span>
                    <p class="text-xs text-slate-400 mt-1">Büyük/küçük harf, rakam ve özel karakter içermelidir.</p>
                </div>

                <!-- Şifre Tekrar -->
                <div>
                    <label asp-for="SifreTekrar" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                    <input asp-for="SifreTekrar"
                           type="password"
                           autocomplete="new-password"
                           class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent transition-all"
                           placeholder="Şifrenizi tekrar girin" />
                    <span asp-validation-for="SifreTekrar" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Kayıt Butonu -->
                <button type="submit"
                        class="w-full py-3 bg-brand-600 text-white font-bold rounded-xl hover:bg-brand-700 transition-all shadow-md hover:shadow-lg text-sm">
                    🌿 Üye Ol
                </button>
            </form>
        </div>

        <!-- Giriş Linki -->
        <p class="text-center text-sm text-slate-400 mt-5">
            Zaten hesabınız var mı?
            <a href="/Account/Giris" class="text-brand-600 font-semibold hover:text-brand-700 transition-colors">
                Giriş Yap →
            </a>
        </p>
    </div>
</div>
